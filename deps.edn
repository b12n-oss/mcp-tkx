{:paths
 ["src"]

 :deps
 {taipei.404/mate                     {:mvn/version "0.1.0"}
  funcool/promesa                     {:mvn/version "11.0.678"}
  metosin/malli                       {:mvn/version "0.20.1"}
  org.clojure/tools.cli               {:mvn/version "1.4.256"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}}

 :aliases
 {:dev      {:extra-deps {org.clojure/clojure       {:mvn/version "1.12.5"}
                          org.clojure/clojurescript {:mvn/version "1.12.145"}}}
  ;; ./bin/kaocha --watch
  :test     {:extra-paths ["test"]
             :extra-deps  {lambdaisland/kaocha      {:mvn/version "1.91.1392"}
                           lambdaisland/kaocha-cljs {:mvn/version "1.9.181"}}
             :main-opts   ["-m" "kaocha.runner"]}
  ;; Coverage, JVM only. Run via `bb coverage`.
  ;;
  ;; Cloverage does not support ClojureScript, and normally that would
  ;; matter for a CLJC library whose suite runs on both. It does not
  ;; here: src/ contains no reader conditionals, so every line the
  ;; ClojureScript build compiles is also exercised on the JVM. The
  ;; number below covers the whole library, not half of it.
  ;;
  ;; Deliberately NOT the kaocha-cloverage plugin, which has had no
  ;; commits since 2023 and pins kaocha 0.0-601 against our 1.91.
  :coverage {:extra-paths ["test"]
             :extra-deps  {cloverage/cloverage  {:mvn/version "1.2.4"}
                           lambdaisland/kaocha  {:mvn/version "1.91.1392"}}
             :main-opts   ["-m" "cloverage.coverage"
                           "--src-ns-path" "src"
                           "--test-ns-path" "test"]}

  ;; clojure -M:outdated --upgrade
  :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
             :main-opts  ["-m" "antq.core"]}

  :nrepl
  {:extra-paths ["test"]
   :extra-deps  {cider/cider-nrepl                        {:mvn/version "0.59.0"}
                 clj-kondo/clj-kondo                      {:mvn/version "2026.05.25"}
                 com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.7.0"}
                 criterium/criterium                      {:mvn/version "0.4.6"}
                 dev.weavejester/cljfmt                   {:mvn/version "0.16.4"}
                 io.github.tonsky/clj-reload              {:mvn/version "1.0.0"}
                 nrepl/nrepl                              {:mvn/version "1.7.0"}
                 org.clojure/tools.cli                    {:mvn/version "1.4.256"}
                 org.slf4j/slf4j-api                      {:mvn/version "2.0.18"}
                 org.slf4j/slf4j-simple                   {:mvn/version "2.0.18"}
                 refactor-nrepl/refactor-nrepl            {:mvn/version "3.13.0"}
                 rewrite-clj/rewrite-clj                  {:mvn/version "1.2.54"}}
   :jvm-opts    ["-Djdk.attach.allowAttachSelf"]
   ;; NOTE: keep this different so we can start each NREPL and connect to it
   :main-opts   ["-m" "nrepl.cmdline" "--port" "7777"]}

  ;; NOTE: no Clojars release is planned. These aliases exist so the
  ;; coordinate is correct if one is ever cut, and so nothing can
  ;; accidentally deploy to fi.metosin, a coordinate this fork does
  ;; not own. Consume this library via :git/sha instead; see README.
  :jar
  {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
   :exec-fn      hf.depstar/jar
   :exec-args    {:sync-pom    true
                  :group-id    "io.github.b12n-oss"
                  :artifact-id "mcp-tkx"
                  :version     "2026-07-28"
                  :jar         "mcp-tkx.jar"}}

  :deploy
  {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
   :exec-fn    deps-deploy.deps-deploy/deploy
   :exec-args  {:installer :remote
                :artifact  "mcp-tkx.jar"}}}}
