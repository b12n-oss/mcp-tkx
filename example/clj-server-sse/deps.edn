{:paths ["src"]
 :deps  {org.clojure/clojure        {:mvn/version "1.12.4"}
         nrepl/nrepl                {:mvn/version "1.5.2"}
         http-kit/http-kit          {:mvn/version "2.9.0-beta3"}
         com.taoensso/telemere      {:mvn/version "1.2.1"}
         metosin/jsonista           {:mvn/version "0.3.13"}
         metosin/reitit-ring        {:mvn/version "0.10.0"}
         metosin/reitit-core        {:mvn/version "0.10.0"}
         medley/medley              {:mvn/version "1.4.0"}
         fi.metosin/mcp-toolkit     {:local/root "../.."}
         example/common-mcp-content {:local/root "../common-mcp-content"}}
 :aliases {:dev        {:extra-deps  {}
                        :extra-paths ["dev"]
                        :jvm-opts    ["-XX:+UseZGC" "--enable-native-access=ALL-UNNAMED"]}
           ;; clojure -X:mcp-server
           :mcp-server {:exec-fn   example.my-server/main
                        :exec-args {:bind "127.0.0.1"
                                    :port 7925}}
           ;; clojure -M:outdated --upgrade
           :outdated   {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                        :main-opts  ["-m" "antq.core"]}}}
