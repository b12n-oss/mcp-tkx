  loc:all
  {:doc "Count lines of code (including tests and examples)"
   :task (let [all-files (concat
                          (fs/glob "src" "**/*.clj")
                          (fs/glob "src" "**/*.cljc")
                          (fs/glob "src" "**/*.cljs")
                          (fs/glob "test" "**/*.clj")
                          (fs/glob "test" "**/*.cljc")
                          (fs/glob "test" "**/*.cljs")
