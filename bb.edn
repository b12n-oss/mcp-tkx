  ;; =============================================================================

  check
  {:doc "⭐ Fast checks (compile + lint) - use before committing"
   :task (do
           (println "🔍 Running fast checks...")
           (println "")
           (step 1 "Compile check...")
           (p/shell "clj" "-M:dev" "-e" "(require 'mcp-toolkit.server)")
           (println)
           (step 2 "Lint check...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (if (zero? exit)
               (println "\n✅ All fast checks passed!")
               (do
                 (println "\n⚠️  Lint warnings found (see above)")
                 (System/exit exit)))))}

  check:full
  {:doc "Comprehensive checks (compile + lint + LSP format + clean-ns)"
   :task (do
           (println "\n🔍 Running Comprehensive Pre-commit Checks")
           (println "==========================================")
           (step 1 "Checking compilation...")
           (p/shell "clj" "-M:dev" "-e" "(require 'mcp-toolkit.server)")
           (println)
           (step 2 "Running clj-kondo lint...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (when-not (zero? exit)
               (println "⚠️  Lint warnings found")))
           (println)
           (step 3 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (println "⚠️  Formatting issues found")
               (println "ℹ️  Run 'bb lsp:format' to fix")))
           (println)
           (step 4 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (println "⚠️  Namespace issues found")
               (println "ℹ️  Run 'bb lsp:clean-ns' to fix")))
           (println "\n✅ All comprehensive checks complete!")
           (println "ℹ️  Fix issues with 'bb lsp:fix' if needed"))}

  ci
  {:doc "Full CI pipeline (clean + compile + lint + test)"
   :task (do
           (step 1 "Cleaning...")
           (doseq [dir ["target" ".cpcache" "classes"]]
             (fs/delete-tree dir))
           (println)
           (step 2 "Compiling...")
           (p/shell "clj" "-M:dev" "-e" "(require 'mcp-toolkit.server)")
           (println)
           (step 3 "Linting...")
           (p/shell "clj-kondo" "--lint" "src")
           (println)
           (step 4 "Running tests...")
           (p/shell "clj" "-M:test")
           (println "\n✅ CI checks complete!"))}

  ;; =============================================================================
  ;; Git Hooks
  ;; =============================================================================

  hooks:install
  {:doc "Install FAST git pre-commit hook (lint only, ~2s)"
   :task (do
           (println "\n🪝 Installing FAST Git Pre-commit Hook")
           (println "======================================")
           (let [hook-path ".git/hooks/pre-commit"
                 hook-content "#!/bin/bash

# mcp-toolkit pre-commit hook (FAST - lint only)
# For comprehensive checks, run 'bb check' or 'bb check:full' manually

set -e

echo \"🔍 Running fast pre-commit check (lint only)...\"
echo \"================================================\"

# Quick lint check only - takes ~2 seconds
clj-kondo --lint src

echo \"\"
echo \"✅ Lint check passed!\"
echo \"ℹ️  For full checks: bb check (or bb check:full for LSP)\"
"]
             (spit hook-path hook-content)
             (p/shell "chmod" "+x" hook-path)
             (println "✅ Fast pre-commit hook installed (lint only, ~2s)")
             (println "ℹ️  Hook will run automatically on 'git commit'")
             (println "ℹ️  To skip: git commit --no-verify")
             (println "ℹ️  For full hook: bb hooks:install:full")))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (compile + lint + LSP, ~30s)"
   :task (do
           (println "\n🪝 Installing FULL Git Pre-commit Hook")
           (println "======================================")
           (let [hook-path ".git/hooks/pre-commit"
                 hook-content "#!/bin/bash

# mcp-toolkit pre-commit hook (FULL - compile + lint + LSP)
# For faster iteration, use 'bb hooks:install' instead

set -e

echo \"🔍 Running FULL pre-commit checks...\"
echo \"=====================================\"

# Step 1: Compile check
echo \"\"
echo \"Step 1: Checking compilation...\"
clojure -M:dev -e \"(require 'mcp-toolkit.server)\"

# Step 2: Lint check
echo \"\"
echo \"Step 2: Running clj-kondo lint...\"
clj-kondo --lint src

# Step 3: Format check
echo \"\"
echo \"Step 3: Checking code formatting...\"
clojure-lsp format --dry --project-root \"$(pwd)\" || {
    echo \"❌ Files need formatting. Run 'bb lsp:format' to fix.\"
    exit 1
}
echo \"✅ Formatting OK\"

# Step 4: Clean-ns check
echo \"\"
echo \"Step 4: Checking namespace forms...\"
clojure-lsp clean-ns --dry --project-root \"$(pwd)\" || {
    echo \"❌ Namespaces need cleaning. Run 'bb lsp:clean-ns' to fix.\"
    exit 1
}
echo \"✅ Namespaces OK\"

echo \"\"
echo \"=====================================\"
echo \"✅ All pre-commit checks passed!\"
"]
             (spit hook-path hook-content)
             (p/shell "chmod" "+x" hook-path)
             (println "✅ Full pre-commit hook installed (compile + lint + LSP)")
             (println "ℹ️  Hook will run automatically on 'git commit'")
             (println "ℹ️  To skip: git commit --no-verify")
             (println "ℹ️  For fast hook: bb hooks:install")))}

  hooks:uninstall
  {:doc "Remove git pre-commit hook"
   :task (do
           (let [hook-path ".git/hooks/pre-commit"]
             (when (fs/exists? hook-path)
               (fs/delete hook-path)
               (println "✅ Pre-commit hook removed!"))
             (when-not (fs/exists? hook-path)
               (println "ℹ️  No pre-commit hook found"))))}

