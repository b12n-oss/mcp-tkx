           (info "nREPL listening on port 7777")
           (p/shell "clj" "-M:nrepl"))}

  repl
  {:doc "Start basic Clojure REPL"
   :override-builtin true
   :task (do
           (info "Starting Clojure REPL...")
           (p/shell "clj" "-M:dev"))}

