{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.process :as p]
             [babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    (def bold "\033[1m")
    (def green "\033[0;32m")
    (def yellow "\033[1;33m")
    (def red "\033[0;31m")
    (def cyan "\033[0;36m")
    (def reset "\033[0m")

    (defn color [c text] (str c text reset))
    (defn step [n text] (println (color yellow (str "Step " n ":")) text))
    (defn success [text] (println (color green (str "✅ " text))))
    (defn error-msg [text] (println (color red (str "❌ " text))))
    (defn info [text] (println (color cyan (str "ℹ️  " text))))
    (defn warn [text] (println (color yellow (str "⚠️  " text))))
    (defn header [text]
      (println)
      (println (color bold text))
      (println (apply str (repeat (count text) "="))))

    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in b12n-oss/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))

    (def docs-engine-repo "https://github.com/b12n-oss/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/b12n-oss--docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task repo-root] (remove nil? args))
              res  (apply p/shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $DOCS_ENGINE, ../docs-engine, ~/dev/b12n-oss--docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this. It checks the engine out itself.")
          (System/exit 1))))

    ;; --- clojure-lsp across every project in the repo ------------------------
    ;; example/* are separate deps.edn projects. clojure-lsp resolves one
    ;; classpath per --project-root, so a single invocation at the repo root
    ;; sees src/ and test/ and nothing under example/. Each project therefore
    ;; needs its own run.
    (defn lsp-project-roots
      "The repo root, then every example/* directory that has a deps.edn."
      []
      (into [repo-root]
            (->> (fs/list-dir (fs/file repo-root "example"))
                 (filter (fn [d] (fs/exists? (fs/file d "deps.edn"))))
                 (map str)
                 sort)))

    (defn lsp-across-projects
      "Runs `clojure-lsp <args> --project-root R` for every project R.
       Returns the number that failed, after running all of them, so one
       bad project does not hide the state of the rest."
      [& args]
      (reduce (fn [failed root]
                (println (str "  " (if (= root repo-root) "." (str/replace root (str repo-root "/") ""))))
                (let [argv (concat ["clojure-lsp"] args ["--project-root" root])
                      {:keys [exit]} (apply p/shell {:continue true} argv)]
                  (if (zero? exit) failed (inc failed))))
              0
              (lsp-project-roots))))

