  ;; Utilities
  ;; =============================================================================

  loc
  {:doc "Count lines of code"
   :task (let [clj-files (concat (fs/glob "src" "**/*.clj")
                                 (fs/glob "src" "**/*.cljc")
                                 (fs/glob "src" "**/*.cljs"))
               lines (map (fn [f] (count (str/split-lines (slurp (str f))))) clj-files)
